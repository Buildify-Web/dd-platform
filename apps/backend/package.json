{
  "name": "@dd/backend",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "tsx watch --env-file-if-exists=.env src/server.ts",
    "build": "tsup",
    "start": "node --env-file-if-exists=.env dist/server.js",
    "admin:bootstrap": "tsx --env-file-if-exists=.env src/scripts/bootstrap-main-admin.ts",
    "lint": "tsc --noEmit",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "seed:dev": "tsx --env-file-if-exists=.env src/scripts/seed-dev.ts"
  },
  "dependencies": {
    "@dd/db": "workspace:*",
    "@dd/shared": "workspace:*",
    "@node-rs/argon2": "^2.2.2",
    "express": "^5.3.0",
    "helmet": "^8.3.0",
    "pino": "^10.4.0",
    "swagger-ui-express": "^5.0.1",
    "zod": "^4.3.4"
  },
  "devDependencies": {
    "@types/express": "^5.0.6",
    "@types/node": "^24.19.2",
    "@types/supertest": "^7.2.0",
    "@types/swagger-ui-express": "^4.1.8",
    "supertest": "^7.3.2",
    "tsup": "^8.5.1",
    "tsx": "^4.23.15",
    "typescript": "^5.9.3",
    "vitest": "^5.1.0"
  }
}
