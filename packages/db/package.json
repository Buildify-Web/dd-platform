{
  "name": "@dd/db",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Prisma schema, migrations and the shared Prisma client. Consumed as TypeScript source.",
  "exports": {
    ".": "./src/index.ts"
  },
  "scripts": {
    "generate": "prisma generate",
    "migrate:dev": "prisma migrate dev",
    "migrate:deploy": "prisma migrate deploy",
    "migrate:status": "prisma migrate status",
    "studio": "prisma studio",
    "postinstall": "prisma generate",
    "lint": "tsc --noEmit",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@prisma/adapter-pg": "7.10.1",
    "@prisma/client": "7.10.1"
  },
  "devDependencies": {
    "@types/node": "^24.19.2",
    "dotenv": "^17.2.3",
    "prisma": "7.10.1",
    "typescript": "^5.9.3"
  }
}
