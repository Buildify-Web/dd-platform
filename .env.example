# Every setting used by the apps. Copy the relevant block into each app's env file:
#   apps/website/.env.local   apps/webapp/.env.local   apps/backend/.env
# Never commit real values. In production, set them in the server's environment.

# ---------- apps/website ----------
# Public URL of the website (used for metadata / sitemap)
NEXT_PUBLIC_SITE_URL=http://localhost:3000
# Backend API base URL. Enquiries are forwarded server-side to ${BACKEND_API_URL}/enquiries.
# Leave empty during website-only development (enquiries are validated and accepted but not stored).
BACKEND_API_URL=
# Shared secret sent as X-Internal-Key when the website server forwards enquiries to the backend.
WEBSITE_INTERNAL_API_KEY=
# Admin & staff portal (apps/webapp, its own domain). Shown as "Admin portal" in the footer.
# Read at request time, so it can change per deployment without a rebuild. Empty = link hidden
# (in development it defaults to http://localhost:3100).
ADMIN_PORTAL_URL=https://portal.example.com

# ---------- apps/webapp (admin & staff portal) ----------
# Backend API, reached only from the webapp server (never from the browser).
BACKEND_API_URL=http://localhost:4000
# Must be one of the backend's INTERNAL_API_KEYS. Generate: node -e "console.log(require('crypto').randomBytes(32).toString('base64url'))"
WEBAPP_INTERNAL_API_KEY=
# Public website (privacy policy link) and the parent app store page ("Parent? Get the app").
WEBSITE_URL=http://localhost:3000
PARENT_APP_URL=
# "Need help? Contact admin"
SUPPORT_EMAIL=meenaannamalai27@gmail.com
# Display only; keep equal to the backend's SESSION_IDLE_MINUTES.
SESSION_IDLE_MINUTES=30

# ---------- apps/backend ----------
NODE_ENV=development
PORT=4000
# Local: `pnpm db:up` starts PostgreSQL on port 55432 with these credentials.
DATABASE_URL=postgresql://dd:dd_local_only@localhost:55432/dd_platform
# Server-to-server keys (comma-separated, ≥32 chars each): the webapp's and the website's keys.
INTERNAL_API_KEYS=
# Number of reverse proxies in front of the API (Caddy = 1).
TRUST_PROXY_HOPS=1
# The owner account. Created by `pnpm admin:bootstrap`; it approves every other admin.
MAIN_ADMIN_EMAIL=meenaannamalai27@gmail.com
MAIN_ADMIN_NAME=Meena Annamalai
# Public URL of the portal, used for links inside emails (activation, password reset).
PORTAL_URL=http://localhost:3100

# Email: Brevo transactional API (https://app.brevo.com → SMTP & API → API keys).
# MAIL_FROM_EMAIL must be a sender verified in Brevo (Senders, domains & IPs).
# Leave BREVO_API_KEY empty in development to print emails to the backend console instead.
BREVO_API_KEY=
MAIL_FROM_EMAIL=
MAIL_FROM_NAME=Dynamic Donalds
MAIL_REPLY_TO=
MAIL_LOG_ONLY=false

# Sessions & security (defaults shown)
SESSION_IDLE_MINUTES=30
SESSION_MAX_HOURS=12
SESSION_REMEMBER_IDLE_DAYS=7
SESSION_REMEMBER_MAX_DAYS=30
LOGIN_MAX_FAILURES=5
LOGIN_LOCK_MINUTES=15
RESET_TOKEN_MINUTES=30
ACTIVATION_TICKET_MINUTES=15
TEMP_PASSWORD_DAYS=7
PASSWORD_HISTORY_COUNT=5
# Swagger UI at /docs: empty = on outside production.
API_DOCS=
LOG_LEVEL=info
