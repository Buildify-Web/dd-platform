# ---------- apps/website ----------
# Public URL of the website (used for metadata / sitemap)
NEXT_PUBLIC_SITE_URL=http://localhost:3000
# Backend API base URL. Enquiries are forwarded server-side to ${BACKEND_API_URL}/enquiries.
# Leave empty during website-only development (enquiries are validated and accepted but not stored).
BACKEND_API_URL=
# Shared secret sent as X-Internal-Key when the website server forwards enquiries to the backend.
WEBSITE_INTERNAL_API_KEY=
